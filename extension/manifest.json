{
  "manifest_version": 3,
  "name": "Medix",
  "version": "0.1.5",
  "description": "一键添加图片到 Medix 媒体库",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["http://localhost:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
